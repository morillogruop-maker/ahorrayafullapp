import { useState } from "react"; import { motion } from "framer-motion"; import { Card, CardContent } from "@/components/ui/card"; import { Button } from "@/components/ui/button"; import { Coins, Brain, Sparkles } from "lucide-react";

export default function AhorraYaIA() { const [rules, setRules] = useState([]); const [amount, setAmount] = useState(0); const [frequency, setFrequency] = useState("Semanal"); const [activated, setActivated] = useState(false);

const addRule = () => { if (amount > 0) { const newRule = { amount, frequency }; setRules([...rules, newRule]); setAmount(0); setActivated(true); } };

return ( <div className="min-h-screen bg-gradient-to-br from-emerald-700 via-green-900 to-black text-white flex flex-col items-center justify-center p-6"> <motion.div initial={{ opacity: 0, y: -20 }} animate={{ opacity: 1, y: 0 }} transition={{ duration: 1 }}> <h1 className="text-5xl font-bold flex items-center gap-3 mb-2"> <Brain className="text-yellow-400" /> Ahorra Ya <span className="text-emerald-400">IA</span> </h1> <p className="text-center text-lg opacity-80 mb-10"> Inteligencia que multiplica tu dinero </p> </motion.div>

<Card className="bg-black/50 border border-emerald-600 rounded-2xl shadow-lg w-full max-w-md">
    <CardContent className="p-6 flex flex-col gap-4">
      <div>
        <label className="block text-sm mb-1">Monto a ahorrar (CLP)</label>
        <input
          type="number"
          className="w-full rounded-lg p-2 bg-emerald-950 border border-emerald-600 text-white"
          value={amount}
          onChange={(e) => setAmount(parseInt(e.target.value))}
        />
      </div>
      <div>
        <label className="block text-sm mb-1">Frecuencia</label>
        <select
          className="w-full rounded-lg p-2 bg-emerald-950 border border-emerald-600 text-white"
          value={frequency}
          onChange={(e) => setFrequency(e.target.value)}
        >
          <option>Diaria</option>
          <option>Semanal</option>
          <option>Mensual</option>
        </select>
      </div>
      <Button onClick={addRule} className="bg-emerald-500 hover:bg-emerald-600 text-black font-semibold">
        Crear Regla de Ahorro
      </Button>
    </CardContent>
  </Card>

  {activated && (
    <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} transition={{ duration: 1 }} className="mt-8">
      <h2 className="text-2xl font-semibold flex items-center gap-2">
        <Sparkles className="text-yellow-300" /> ¡Regla activada!
      </h2>
      <p className="text-center text-emerald-300 mt-2">Tu IA financiera está en marcha 🚀</p>
    </motion.div>
  )}

  {rules.length > 0 && (
    <div className="mt-10 w-full max-w-md">
      <h3 className="text-xl mb-4 font-bold flex items-center gap-2">
        <Coins className="text-yellow-400" /> Reglas creadas
      </h3>
      {rules.map((r, i) => (
        <div key={i} className="bg-emerald-950/50 border border-emerald-700 p-3 mb-2 rounded-xl">
          <p>Monto: {r.amount} CLP</p>
          <p>Frecuencia: {r.frequency}</p>
        </div>
      ))}
    </div>
  )}
</div>

); }
